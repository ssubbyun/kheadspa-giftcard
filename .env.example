# [Stripe 결제 설정]
# Stripe Dashboard -> Developers -> API keys 에서 확인 (pk_test_ / pk_live_ 모두 지원)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample

# [데모 결제 시뮬레이션 모드 (실제 Stripe 키 입력 시 서버에서 자동 비활성화됨)]
ALLOW_DEMO_CHECKOUT=true
NEXT_PUBLIC_DEMO_CHECKOUT=true

# [애플리케이션 도메인 URL]
# 로컬 개발 시: http://localhost:3000
# 프로덕션 배포 시: https://gift.kheadspawellness.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [예약 페이지 연결 URL]
NEXT_PUBLIC_BOOKING_URL=https://kheadspawellness.glossgenius.com

# [매장 관리자 PIN 번호]
# 매장 직원 POS 화면(Redeem/차감/재발송) 접근 및 실행용 (최소 4자리 이상)
STAFF_PORTAL_PIN=1234

# [이메일 발송 - Resend REST API (추후 키 입력 시 자동 활성화)]
RESEND_API_KEY=
EMAIL_FROM="K-headspa & wellness <noreply@kheadspawellness.com>"

# [문자 SMS 발송 - Twilio REST API (추후 키 입력 시 자동 활성화)]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# [Firebase Admin SDK 설정 (Firestore 연동)]
# 미설정 시 로컬 JSON 파일(data/gift_cards_store.json) 기반으로 자동 동작합니다.
# Firebase 콘솔 -> 프로젝트 설정 -> 서비스 계정 -> 새 비공개 키 생성
# FIREBASE_PROJECT_ID=kheadspa-giftcard
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kheadspa-giftcard.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
