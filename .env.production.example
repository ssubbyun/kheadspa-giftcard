# [실운영 프로덕션 환경]
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

# [실운영 도메인 URL]
NEXT_PUBLIC_APP_URL=https://gift.kheadspawellness.com
NEXT_PUBLIC_BOOKING_URL=https://kheadspawellness.glossgenius.com

# [Stripe Live 실키 입력 (pk_live_ / sk_live_ 입력 필요)]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_placeholder
STRIPE_SECRET_KEY=sk_live_placeholder

# [실운영 서버에서는 데모 결제가 코드 레벨에서 영구 차단됩니다]
ALLOW_DEMO_CHECKOUT=false
NEXT_PUBLIC_DEMO_CHECKOUT=false

# [실운영 매장 POS PIN — 매장 오픈 전 반드시 4자리 이상 고유 PIN으로 변경하세요]
STAFF_PORTAL_PIN=1234

# [이메일 (Resend) & 문자 (Twilio) 실운영 API 키]
RESEND_API_KEY=
EMAIL_FROM="K-headspa & wellness <noreply@kheadspawellness.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
