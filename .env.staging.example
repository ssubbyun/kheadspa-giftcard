# [스테이징 / 테스트 서버 환경]
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging

# [도메인 URL]
# 커스텀 도메인 연결 시 예: https://gift-dev.kheadspawellness.com
NEXT_PUBLIC_APP_URL=https://kheadspa-giftcard-staging.web.app
NEXT_PUBLIC_BOOKING_URL=https://kheadspawellness.glossgenius.com

# [Stripe Test / Sandbox 키 또는 데모 모드]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
ALLOW_DEMO_CHECKOUT=true
NEXT_PUBLIC_DEMO_CHECKOUT=true

# [테스트 매장 POS PIN]
STAFF_PORTAL_PIN=1234

# [이메일 / SMS 테스트 키 (비워두면 안전하게 발송 스킵)]
RESEND_API_KEY=
EMAIL_FROM="K-headspa & wellness [TEST] <noreply@kheadspawellness.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
